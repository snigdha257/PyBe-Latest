# ─────────────────────────────────────────────────────────────────────
# PyBe Latest — server environment template
#
# Copy this file to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is git-ignored. NEVER commit a populated `.env` to source.
# In CI / production, set these as real environment variables instead.
# ─────────────────────────────────────────────────────────────────────

# Web server port. Defaults to 5000 if unset.
PORT=5000

# MongoDB connection string. For local dev this is fine:
#   mongodb://localhost:27017/pybe-latest
# For staging / production use Atlas or a managed MongoDB:
#   mongodb+srv://USER:PASS@cluster0.example.net/pybe-latest?retryWrites=true
MONGO_URI=mongodb://localhost:27017/pybe-latest

# JWT signing secret. MUST be replaced before any deployment beyond local dev.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# The server refuses to boot with a placeholder value in production.
JWT_SECRET=replace-me-with-a-long-random-string

# Optional. Set to 1 ONLY in local dev to skip the JWT-secret-strength check.
# In production this MUST be unset or 0 — the server will hard-fail otherwise.
# ALLOW_INSECURE_DEV=1
